---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="breadcrumb" aria-label="Breadcrumb">
  {
    items.map((item, index) => (
      <>
        {index > 0 && <span aria-hidden="true">/</span>}
        {item.href ? (
          <a href={item.href}>{item.label}</a>
        ) : (
          <span style="color: var(--ink)" aria-current="page">
            {item.label}
          </span>
        )}
      </>
    ))
  }
</nav>
