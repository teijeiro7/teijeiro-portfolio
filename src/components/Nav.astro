---
import { site } from "../data/content";
import { pathFor, t, type Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  currentPath: string;
}

const { locale, currentPath } = Astro.props;

const links = [
  { id: "index", num: "01", label: site.ui.nav.index, href: "/", match: "/" },
  { id: "work", num: "02", label: site.ui.nav.work, href: "/work", match: "/work" },
  {
    id: "experience",
    num: "03",
    label: site.ui.nav.experience,
    href: "/experience",
    match: "/experience",
  },
  {
    id: "contact",
    num: "04",
    label: site.ui.nav.contact,
    href: "/contact",
    match: "/contact",
  },
];

const isCurrent = (match: string) =>
  match === "/" ? currentPath === "/" : currentPath === match || currentPath.startsWith(`${match}/`);

const languageName = { en: "English", es: "Español" } as const;

const switchTo = (target: Locale) => pathFor(currentPath, target);
---

<header class="nav">
  <div class="shell nav-inner">
    <a class="brand" href={pathFor("/", locale)} aria-label={site.meta.name}>
      <span class="mark">
        <img src="/logo-mark.svg" alt="" width="22" height="22" />
      </span>
      <span>
        Cristian Teijeiro<span class="slash">/</span><span class="role"
          >{t(site.ui.role, locale)}</span
        >
      </span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {
        links.map((link) => (
          <a
            class="nav-link"
            href={pathFor(link.href, locale)}
            aria-current={isCurrent(link.match) ? "page" : undefined}
          >
            <sup>{link.num}</sup>
            {t(link.label, locale)}
          </a>
        ))
      }
    </nav>

    <div class="nav-actions">
      <div class="nav-tools" role="group" aria-label="Display">
        <div class="lang" role="group" aria-label={t(site.ui.language, locale)}>
          <a
            href={switchTo("es")}
            hreflang="es"
            lang="es"
            aria-label={languageName.es}
            aria-current={locale === "es" ? "true" : "false"}>ES</a
          >
          <a
            href={switchTo("en")}
            hreflang="en"
            lang="en"
            aria-label={languageName.en}
            aria-current={locale === "en" ? "true" : "false"}>EN</a
          >
        </div>
        <button class="icon-btn" data-theme-toggle aria-label={t(site.ui.theme, locale)}>
          <svg class="only-light" viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg
          >
          <svg class="only-dark" viewBox="0 0 24 24" aria-hidden="true"
            ><circle cx="12" cy="12" r="4"></circle><path
              d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"
            ></path></svg
          >
        </button>
        <button
          class="icon-btn menu-btn"
          data-menu
          aria-expanded="false"
          aria-label={t(site.ui.menu, locale)}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M4 7h16M4 12h16M4 17h16"></path></svg
          >
        </button>
      </div>
    </div>
  </div>
  <div class="progress" aria-hidden="true"><span></span></div>
</header>

<div class="sheet" data-sheet data-open="false">
  <nav aria-label="Mobile">
    {
      links.map((link) => (
        <a href={pathFor(link.href, locale)}>
          {t(link.label, locale)} <span>{link.num}</span>
        </a>
      ))
    }
  </nav>
  <div class="sheet-lang" role="group" aria-label={t(site.ui.language, locale)}>
    <a
      href={switchTo("es")}
      hreflang="es"
      lang="es"
      aria-current={locale === "es" ? "true" : "false"}>ES</a
    >
    <a
      href={switchTo("en")}
      hreflang="en"
      lang="en"
      aria-current={locale === "en" ? "true" : "false"}>EN</a
    >
  </div>
  <div class="sheet-foot">
    <span class="status"><i class="dot"></i>{t(site.ui.status, locale)}</span>
    <span class="mono">{t(site.ui.city, locale)}</span>
  </div>
</div>
