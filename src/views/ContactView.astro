---
import Arrow from "../components/Arrow.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import { contact, site } from "../data/content";
import { pathFor, t, type Locale } from "../lib/i18n";
import { inline } from "../lib/text";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const lines = (value: string) => value.split("|");
---

<section class="contact-hero">
  <div class="shell">
    <Breadcrumb
      items={[
        { label: t(site.ui.nav.index, locale), href: pathFor("/", locale) },
        { label: t(site.ui.nav.contact, locale) },
      ]}
    />

    <div class="contact-grid">
      <div>
        <span class="eyebrow"><span class="idx">05</span>{t(contact.eyebrow, locale)}</span>
        <h1 class="h1" style="margin-top: 14px" set:html={inline(t(contact.title, locale))} />
        <p class="lead contact-lead">{t(contact.lead, locale)}</p>

        <div class="email-box">
          <span class="addr">{site.meta.email}</span>
          <button
            class="copy-btn"
            type="button"
            data-copy={site.meta.email}
            data-copy-label={t(site.ui.labels.copy, locale)}
            data-copied-label={t(site.ui.labels.copied, locale)}
            aria-label={`${t(site.ui.labels.copy, locale)} ${site.meta.email}`}
          >
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><rect x="9" y="9" width="12" height="12" rx="1"></rect><path
                d="M5 15V4a1 1 0 0 1 1-1h11"></path></svg
            >
            <span>{t(site.ui.labels.copy, locale)}</span>
          </button>
        </div>

        <dl class="contact-facts">
          {
            contact.facts.map((fact) => {
              const parts = lines(t(fact.value, locale));
              return (
                <div class="contact-fact">
                  <dt>{t(fact.label, locale)}</dt>
                  <dd>
                    {fact.clock ? (
                      <>
                        <span data-clock>--:--</span>
                        <br />
                        {parts[1]}
                      </>
                    ) : (
                      <>
                        {parts.map((part, index) => (
                          <>
                            {index > 0 && <br />}
                            {part}
                          </>
                        ))}
                        {fact.sub && (
                          <>
                            <br />
                            <span class="mono" style="color: var(--faint); font-size: 8.5px">
                              {t(fact.sub, locale)}
                            </span>
                          </>
                        )}
                      </>
                    )}
                  </dd>
                </div>
              );
            })
          }
        </dl>

        <div class="socials">
          <a class="social" href={site.meta.github} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.57.1.78-.25.78-.55v-2.16c-3.2.7-3.87-1.37-3.87-1.37-.52-1.33-1.28-1.68-1.28-1.68-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.25.73-1.54-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.09-.12-.29-.51-1.46.11-3.04 0 0 .97-.31 3.18 1.18a11.06 11.06 0 0 1 5.8 0c2.21-1.49 3.18-1.18 3.18-1.18.62 1.58.23 2.75.11 3.04.74.8 1.18 1.83 1.18 3.09 0 4.43-2.7 5.41-5.27 5.69.41.36.78 1.06.78 2.14v3.17c0 .31.21.66.79.55A11.51 11.51 0 0 0 23.5 12C23.5 5.65 18.35.5 12 .5Z"
              ></path></svg
            >
            GitHub
          </a>
          <a class="social" href={site.meta.linkedin} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"
              ><path
                d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13Zm1.78 13.02H3.56V9h3.56v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
              ></path></svg
            >
            LinkedIn
          </a>
        </div>
      </div>

      <form
        class="form reveal"
        data-mail-form
        data-mail-to={site.meta.email}
        data-mail-subject={t(contact.form.defaultSubject, locale)}
      >
        <div class="form-head">
          <span class="mono">{t(contact.form.head, locale)}</span>
          <span class="status"><i class="dot"></i>{t(contact.form.status, locale)}</span>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="name">{t(contact.form.name, locale)}</label>
            <input
              id="name"
              name="name"
              type="text"
              placeholder={t(contact.form.placeholders.name, locale)}
              autocomplete="name"
            />
          </div>
          <div class="field">
            <label for="email">{t(contact.form.email, locale)}</label>
            <input
              id="email"
              name="email"
              type="email"
              placeholder={t(contact.form.placeholders.email, locale)}
              autocomplete="email"
            />
          </div>
        </div>
        <div class="field">
          <label for="subject">{t(contact.form.subject, locale)}</label>
          <input
            id="subject"
            name="subject"
            type="text"
            placeholder={t(contact.form.placeholders.subject, locale)}
          />
        </div>
        <div class="field">
          <label for="message">{t(contact.form.message, locale)}</label>
          <textarea
            id="message"
            name="message"
            placeholder={t(contact.form.placeholders.message, locale)}
            required
          ></textarea>
        </div>
        <button class="btn" type="submit" style="width: 100%">
          {t(contact.form.submit, locale)}
          <Arrow />
        </button>
        <p class="form-note">{t(contact.form.note, locale)}</p>
      </form>
    </div>
  </div>
</section>

<section class="section">
  <div class="shell faq-layout">
    <div>
      <span class="eyebrow" style="margin-bottom: 14px">{t(contact.faq.eyebrow, locale)}</span>
      <h2 class="h2">{t(contact.faq.title, locale)}</h2>
      <p class="body" style="margin-top: 14px">{t(contact.faq.body, locale)}</p>
    </div>

    <div class="faq">
      {
        contact.faq.items.map((item, index) => (
          <details open={index === 0}>
            <summary>{t(item.q, locale)}</summary>
            <p>{t(item.a, locale)}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
